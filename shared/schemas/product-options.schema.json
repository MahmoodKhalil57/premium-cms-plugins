{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Product options",
	"description": "Configurable parts of this product: each field is asked on the product page; choices can add to the price and track their own stock. Conditions show a field only when another has a value.",
	"type": "array",
	"items": {
		"type": "object",
		"title": "Field",
		"x-itemTitle": "label",
		"required": [
			"type",
			"name",
			"label"
		],
		"properties": {
			"type": {
				"type": "string",
				"title": "Type",
				"enum": [
					"text",
					"email",
					"textarea",
					"number",
					"tel",
					"url",
					"date",
					"select",
					"radio",
					"checkbox",
					"checkbox-group",
					"file",
					"hidden",
					"swatch",
					"image-choice",
					"design"
				],
				"x-enumLabels": {
					"text": "Short text",
					"textarea": "Paragraph",
					"email": "Email",
					"tel": "Phone",
					"url": "Website",
					"number": "Number",
					"date": "Date",
					"select": "Dropdown",
					"radio": "Single choice",
					"checkbox": "Checkbox",
					"checkbox-group": "Multiple choice",
					"file": "File upload",
					"hidden": "Hidden value",
					"swatch": "Colour swatches",
					"image-choice": "Picture choice",
					"design": "Design studio"
				},
				"x-ui": {
					"order": 0
				}
			},
			"label": {
				"type": "string",
				"title": "Label",
				"x-ui": {
					"order": 1
				}
			},
			"name": {
				"type": "string",
				"title": "Name",
				"description": "Key used in orders and conditions, e.g. collar",
				"x-ui": {
					"order": 2
				}
			},
			"id": {
				"type": "string",
				"title": "ID",
				"description": "Optional; defaults to the name",
				"x-ui": {
					"order": 3
				}
			},
			"required": {
				"type": "boolean",
				"title": "Required"
			},
			"width": {
				"type": "string",
				"title": "Width",
				"enum": [
					"full",
					"half"
				],
				"x-enumLabels": {
					"full": "Full width",
					"half": "Half width"
				}
			},
			"placeholder": {
				"type": "string",
				"title": "Placeholder"
			},
			"helpText": {
				"type": "string",
				"title": "Help text"
			},
			"defaultValue": {
				"type": "string",
				"title": "Default value"
			},
			"options": {
				"type": "array",
				"title": "Choices",
				"items": {
					"type": "object",
					"title": "Choice",
					"x-itemTitle": "label",
					"required": [
						"value",
						"label"
					],
					"properties": {
						"label": {
							"type": "string",
							"title": "Label",
							"x-ui": {
								"order": 0
							}
						},
						"value": {
							"type": "string",
							"title": "Value",
							"description": "Stored key \u2014 letters, numbers, dashes",
							"x-ui": {
								"order": 1
							}
						},
						"priceDelta": {
							"type": "number",
							"title": "Price added when chosen"
						},
						"color": {
							"type": "string",
							"format": "color",
							"title": "Colour (swatches)"
						},
						"image": {
							"type": "string",
							"format": "uri",
							"title": "Image URL (picture choices)"
						},
						"stock": {
							"type": "integer",
							"title": "Stock for this choice",
							"minimum": 0
						},
						"sku": {
							"type": "string",
							"title": "SKU"
						},
						"description": {
							"type": "string",
							"title": "Description"
						}
					}
				},
				"x-showWhen": {
					"field": "type",
					"in": [
						"select",
						"radio",
						"checkbox-group",
						"swatch",
						"image-choice"
					]
				}
			},
			"priceDelta": {
				"type": "number",
				"title": "Price added when filled",
				"x-showWhen": {
					"field": "type",
					"in": [
						"text",
						"textarea",
						"number",
						"checkbox",
						"file",
						"date",
						"design"
					]
				}
			},
			"validation": {
				"type": "object",
				"title": "Validation",
				"x-ui": {
					"collapsed": true
				},
				"properties": {
					"minLength": {
						"type": "integer",
						"title": "Min length",
						"minimum": 0
					},
					"maxLength": {
						"type": "integer",
						"title": "Max length",
						"minimum": 1
					},
					"min": {
						"type": "number",
						"title": "Minimum"
					},
					"max": {
						"type": "number",
						"title": "Maximum"
					},
					"pattern": {
						"type": "string",
						"title": "Pattern (regex)"
					},
					"patternMessage": {
						"type": "string",
						"title": "Pattern error message"
					},
					"accept": {
						"type": "string",
						"title": "Accepted file types"
					},
					"maxFileSize": {
						"type": "integer",
						"title": "Max file size (bytes)"
					}
				}
			},
			"condition": {
				"type": "object",
				"title": "Show only when\u2026",
				"x-ui": {
					"collapsed": true
				},
				"properties": {
					"field": {
						"type": "string",
						"title": "Other field (name)"
					},
					"op": {
						"type": "string",
						"title": "Condition",
						"enum": [
							"eq",
							"neq",
							"in",
							"nin",
							"filled",
							"empty"
						],
						"x-enumLabels": {
							"eq": "equals",
							"neq": "does not equal",
							"in": "is one of (comma-separated)",
							"nin": "is none of (comma-separated)",
							"filled": "is filled",
							"empty": "is empty"
						}
					},
					"value": {
						"type": "string",
						"title": "Value"
					}
				}
			},
			"design": {
				"title": "Design studio",
				"type": "object",
				"description": "Print areas the customer designs on, artwork they can place, and what the studio allows.",
				"required": [
					"areas"
				],
				"properties": {
					"areas": {
						"type": "array",
						"title": "Print areas",
						"minItems": 1,
						"items": {
							"type": "object",
							"title": "Print area",
							"x-itemTitle": "label",
							"required": [
								"id",
								"label",
								"width",
								"height"
							],
							"properties": {
								"id": {
									"type": "string",
									"title": "ID",
									"description": "Short key, e.g. front",
									"x-ui": {
										"order": 0
									}
								},
								"label": {
									"type": "string",
									"title": "Label",
									"x-ui": {
										"order": 1
									}
								},
								"width": {
									"type": "integer",
									"title": "Width (design units)",
									"minimum": 1,
									"maximum": 4000
								},
								"height": {
									"type": "integer",
									"title": "Height (design units)",
									"minimum": 1,
									"maximum": 4000
								},
								"previewImage": {
									"type": "string",
									"format": "uri",
									"title": "Mockup image URL",
									"description": "Garment photo shown under the print area"
								},
								"printBox": {
									"type": "object",
									"title": "Print box on the mockup (%)",
									"x-ui": {
										"collapsed": false
									},
									"properties": {
										"x": {
											"type": "number",
											"title": "Left %",
											"minimum": 0,
											"maximum": 100
										},
										"y": {
											"type": "number",
											"title": "Top %",
											"minimum": 0,
											"maximum": 100
										},
										"w": {
											"type": "number",
											"title": "Width %",
											"minimum": 1,
											"maximum": 100
										},
										"h": {
											"type": "number",
											"title": "Height %",
											"minimum": 1,
											"maximum": 100
										}
									}
								}
							}
						}
					},
					"presets": {
						"type": "array",
						"title": "Preset artwork",
						"items": {
							"type": "object",
							"title": "Artwork",
							"x-itemTitle": "label",
							"required": [
								"id",
								"label",
								"image"
							],
							"properties": {
								"id": {
									"type": "string",
									"title": "ID"
								},
								"label": {
									"type": "string",
									"title": "Label"
								},
								"image": {
									"type": "string",
									"format": "uri",
									"title": "Image URL"
								},
								"priceDelta": {
									"type": "number",
									"title": "Price added when used"
								}
							}
						}
					},
					"allowText": {
						"type": "boolean",
						"title": "Allow text",
						"default": true
					},
					"allowUpload": {
						"type": "boolean",
						"title": "Allow customer images",
						"default": true
					},
					"allowShapes": {
						"type": "boolean",
						"title": "Allow shapes",
						"default": true
					},
					"fonts": {
						"type": "array",
						"title": "Fonts",
						"items": {
							"type": "string"
						},
						"x-ui": {
							"widget": "chips",
							"placeholder": "Inter, Arial, Impact\u2026"
						}
					},
					"colors": {
						"type": "array",
						"title": "Colour swatches",
						"items": {
							"type": "string"
						},
						"x-ui": {
							"widget": "chips",
							"placeholder": "#111111, #ffffff\u2026"
						}
					},
					"maxLayers": {
						"type": "integer",
						"title": "Max layers",
						"minimum": 1,
						"maximum": 12
					},
					"uploadMaxBytes": {
						"type": "integer",
						"title": "Max upload size (bytes)",
						"minimum": 1
					},
					"textPriceDelta": {
						"type": "number",
						"title": "Price added for text"
					},
					"uploadPriceDelta": {
						"type": "number",
						"title": "Price added for a customer image"
					}
				},
				"x-showWhen": {
					"field": "type",
					"equals": "design"
				},
				"x-ui": {
					"collapsed": false
				}
			}
		}
	}
}
