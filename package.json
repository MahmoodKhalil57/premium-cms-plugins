{
	"name": "premium-cms-plugins",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "PremiumCMS marketplace plugins for EmDash",
	"workspaces": [
		"plugins/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"validate": "for d in plugins/*/; do npx @emdash-cms/plugin-cli validate \"$d\"; done",
		"new": "bin/new-plugin.sh",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "^0.8.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"lint-staged": {
		"*.{json,jsonc}": "bin/check-json.mjs",
		"*.{js,mjs,ts,tsx,css,md,json,jsonc,yml,yaml}": "prettier --write --ignore-unknown"
	}
}
