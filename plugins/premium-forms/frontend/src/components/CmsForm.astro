---
/**
 * Pre-rendered form from the premium-forms plugin. Fetches the public form
 * definition at build time and renders the same markup the runtime
 * hydrator produces, so it works without JavaScript and is enhanced by
 * src/scripts/forms.ts (loaded by the layout) when it runs.
 *
 *   <CmsForm id="contact" />
 */
import { CMS_URL } from "../config";
import { renderForm } from "../scripts/forms";

interface Props {
	id: string;
}
const { id } = Astro.props;

let html = "";
try {
	const url = `${CMS_URL}/_emdash/api/plugins/premium-forms/definition?id=${encodeURIComponent(id)}`;
	let res = await fetch(url, { signal: AbortSignal.timeout(10000) });
	if (res.status === 404) {
		// Cold CMS isolate still loading marketplace plugins — retry once.
		await new Promise((r) => setTimeout(r, 1500));
		res = await fetch(url, { signal: AbortSignal.timeout(10000) });
	}
	if (res.ok) {
		const body = (await res.json()) as { data?: unknown };
		const def = (body && typeof body === "object" && "data" in body ? body.data : body) as Parameters<typeof renderForm>[0];
		html = renderForm(def, id);
	}
} catch {
	/* fall through to the placeholder, hydrated at runtime */
}
---

{html ? <Fragment set:html={html} /> : <div data-cms-form={id}></div>}
