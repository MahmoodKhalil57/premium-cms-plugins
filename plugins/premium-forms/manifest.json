{
	"id": "premium-forms",
	"version": "0.5.0",
	"capabilities": [
		"email:send",
		"network:request:unrestricted",
		"media:write"
	],
	"allowedHosts": [],
	"storage": {
		"forms": {
			"indexes": [
				"status",
				"createdAt"
			],
			"uniqueIndexes": [
				"slug"
			]
		},
		"submissions": {
			"indexes": [
				"formId",
				"status",
				"starred",
				"createdAt",
				[
					"formId",
					"createdAt"
				],
				[
					"formId",
					"status"
				]
			]
		}
	},
	"hooks": [
		{
			"name": "plugin:activate"
		},
		{
			"name": "cron"
		}
	],
	"routes": [
		{
			"name": "submit",
			"public": true
		},
		{
			"name": "definition",
			"public": true
		},
		{
			"name": "admin",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "forms/list",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "forms/create",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "forms/update",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "forms/delete",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "forms/duplicate",
			"permission": "premium-forms:forms:manage"
		},
		{
			"name": "submissions/list",
			"permission": "premium-forms:submissions:read"
		},
		{
			"name": "submissions/get",
			"permission": "premium-forms:submissions:read"
		},
		{
			"name": "submissions/update",
			"permission": "premium-forms:submissions:manage"
		},
		{
			"name": "submissions/delete",
			"permission": "premium-forms:submissions:manage"
		},
		{
			"name": "submissions/export",
			"permission": "premium-forms:submissions:read"
		}
	],
	"admin": {
		"pages": [
			{
				"path": "/",
				"label": "Forms",
				"icon": "list"
			},
			{
				"path": "/builder",
				"label": "Builder",
				"icon": "grid"
			},
			{
				"path": "/submissions",
				"label": "Submissions",
				"icon": "inbox"
			}
		],
		"widgets": [
			{
				"id": "recent-submissions",
				"title": "Recent submissions",
				"size": "half"
			}
		],
		"settingsSchema": {
			"turnstileSiteKey": {
				"type": "string",
				"label": "Turnstile site key",
				"description": "Cloudflare Turnstile widget site key (for forms using Turnstile spam protection)."
			},
			"turnstileSecretKey": {
				"type": "secret",
				"label": "Turnstile secret key"
			}
		}
	},
	"grants": [
		{
			"key": "forms:manage",
			"label": "Manage forms",
			"description": "Create, edit and delete forms (Builder)"
		},
		{
			"key": "submissions:read",
			"label": "Read submissions",
			"description": "View and export form submissions"
		},
		{
			"key": "submissions:manage",
			"label": "Manage submissions",
			"description": "Mark, star, delete submissions"
		}
	]
}
