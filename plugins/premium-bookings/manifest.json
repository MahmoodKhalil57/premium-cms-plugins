{
	"id": "premium-bookings",
	"version": "1.0.4",
	"capabilities": [
		"email:send",
		"users:read",
		"plugins:call"
	],
	"allowedHosts": [],
	"storage": {
		"services": {
			"indexes": [
				"slug",
				"kind",
				"active",
				"sortOrder",
				"managedBy"
			]
		},
		"resources": {
			"indexes": [
				"kind",
				"active",
				"name",
				"userId",
				"externalId",
				"managedBy"
			]
		},
		"bookings": {
			"indexes": [
				"status",
				"startsAt",
				"serviceId",
				"resourceId",
				"orderId",
				"serviceKind",
				[
					"status",
					"startsAt"
				]
			]
		},
		"automations": {
			"indexes": [
				"active",
				"trigger"
			]
		}
	},
	"hooks": [
		{
			"name": "plugin:activate"
		},
		{
			"name": "cron"
		},
		{
			"name": "plugin:event",
			"events": [
				"premium-commerce:order.created",
				"premium-commerce:order.paid",
				"premium-commerce:order.cancelled",
				"premium-commerce:order.refunded"
			]
		}
	],
	"routes": [
		{
			"name": "config",
			"public": true,
			"cacheControl": "public, max-age=60"
		},
		{
			"name": "services",
			"public": true
		},
		{
			"name": "availability",
			"public": true
		},
		{
			"name": "days",
			"public": true
		},
		{
			"name": "hold",
			"public": true
		},
		{
			"name": "lookup",
			"public": true
		},
		{
			"name": "cancel",
			"public": true
		},
		{
			"name": "account/bookings",
			"session": true
		},
		{
			"name": "admin",
			"permission": "premium-bookings:bookings:read"
		},
		{
			"name": "stats",
			"permission": "premium-bookings:bookings:read"
		},
		{
			"name": "bookings/list",
			"permission": "premium-bookings:bookings:read"
		},
		{
			"name": "bookings/update",
			"permission": "premium-bookings:bookings:manage"
		},
		{
			"name": "bookings/create",
			"permission": "premium-bookings:bookings:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "services/list",
			"permission": "premium-bookings:bookings:read"
		},
		{
			"name": "services/save",
			"permission": "premium-bookings:setup:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "services/delete",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "resources/list",
			"permission": "premium-bookings:bookings:read",
			"callers": [
				"*"
			]
		},
		{
			"name": "resources/save",
			"permission": "premium-bookings:setup:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "resources/delete",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "users/list",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "automations/list",
			"permission": "premium-bookings:bookings:read"
		},
		{
			"name": "automations/save",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "automations/delete",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "automations/run",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "commerce/line",
			"permission": "premium-bookings:bookings:manage",
			"callers": [
				"premium-commerce"
			]
		},
		{
			"name": "resources/sync",
			"permission": "premium-bookings:setup:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "resources/unsync",
			"permission": "premium-bookings:setup:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "services/sync",
			"permission": "premium-bookings:setup:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "bookings/query",
			"permission": "premium-bookings:bookings:read",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/config",
			"permission": "premium-bookings:bookings:read",
			"callers": [
				"*"
			]
		},
		{
			"name": "migrate/commerce",
			"permission": "premium-bookings:setup:manage"
		},
		{
			"name": "config/export",
			"permission": "premium-bookings:setup:manage"
		}
	],
	"admin": {
		"pages": [
			{
				"path": "/",
				"label": "Bookings",
				"icon": "calendar"
			},
			{
				"path": "/services",
				"label": "Services",
				"icon": "list"
			},
			{
				"path": "/resources",
				"label": "Staff & resources",
				"icon": "users"
			},
			{
				"path": "/automations",
				"label": "Automations",
				"icon": "lightning"
			}
		],
		"widgets": [
			{
				"id": "upcoming",
				"title": "Upcoming bookings",
				"size": "half"
			}
		],
		"settingsSchema": {
			"businessName": {
				"type": "string",
				"label": "Business name",
				"description": "Used in emails (\"See you soon, Harley Smile Studio\")."
			},
			"timezone": {
				"type": "string",
				"label": "Time zone",
				"default": "UTC",
				"description": "IANA zone the hours and slots are in, e.g. Europe/London."
			},
			"currency": {
				"type": "string",
				"label": "Currency",
				"default": "usd",
				"description": "Prices on services are in this currency; payments go through the Commerce plugin, which should use the same one."
			},
			"slotIntervalMin": {
				"type": "number",
				"label": "Slot interval (minutes)",
				"default": 15
			},
			"leadTimeHours": {
				"type": "number",
				"label": "Minimum notice (hours)",
				"default": 2,
				"description": "Earliest a customer can book from now."
			},
			"horizonDays": {
				"type": "number",
				"label": "Booking horizon (days)",
				"default": 60
			},
			"holdMinutes": {
				"type": "number",
				"label": "Hold a slot while paying (minutes)",
				"default": 15
			},
			"cancelHours": {
				"type": "number",
				"label": "Online cancellation cut-off (hours before)",
				"default": 2
			},
			"managePath": {
				"type": "string",
				"label": "Booking page path",
				"default": "/book",
				"description": "Where the site renders the booking widget; confirmation links point here."
			},
			"notifyEmail": {
				"type": "string",
				"label": "Notify email",
				"description": "Gets a copy of every new booking and cancellation."
			}
		}
	},
	"grants": [
		{
			"key": "bookings:read",
			"label": "View bookings",
			"description": "See the calendar, services and resources"
		},
		{
			"key": "bookings:manage",
			"label": "Manage bookings",
			"description": "Confirm, reschedule, complete, cancel and add bookings"
		},
		{
			"key": "setup:manage",
			"label": "Set up bookings",
			"description": "Edit services, staff & resources and automations"
		}
	]
}
