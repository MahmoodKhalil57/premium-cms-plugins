		"settingsSchema": {
			"paymentProvider": {
				"type": "select",
				"label": "Payment provider",
				"description": "Who charges your customers at checkout. Pay-later orders work without one.",
				"default": "none",
				"options": [
					{
						"value": "none",
						"label": "None (pay-later orders only)"
					},
					{
						"value": "stripe",
						"label": "Stripe"
					},
					{
						"value": "polar",
						"label": "Polar"
					}
				]
			},
			"currency": {
				"type": "string",
				"label": "Currency",
				"description": "ISO code, e.g. usd, eur, gbp, aed. Prices in the Products collection are in this currency."
			},
			"stripeSecretKey": {
				"type": "secret",
				"label": "Stripe secret key",
				"description": "sk_live_\u2026 or sk_test_\u2026. Checkout, refunds and payment verification use it; it never leaves the server.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"stripeWebhookSecret": {
				"type": "secret",
				"label": "Stripe webhook signing secret",
				"description": "whsec_\u2026 of the webhook endpoint you create at dashboard.stripe.com/webhooks for the URL below (events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired).",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"stripeWebhookUrl": {
				"type": "info",
				"label": "Stripe webhook URL",
				"description": "Add this endpoint in Stripe \u2192 Developers \u2192 Webhooks.",
				"value": "{{origin}}/commerce-webhook/stripe",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"automaticTax": {
				"type": "boolean",
				"label": "Stripe Tax (automatic tax calculation)",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"shippingRates": {
				"type": "string",
				"label": "Stripe shipping rate ids",
				"description": "Comma-separated shr_\u2026 ids offered at checkout for physical products.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"polarAccessToken": {
				"type": "secret",
				"label": "Polar organization access token",
				"description": "polar_oat_\u2026 with checkouts:read, checkouts:write, orders:read and refunds:write scopes.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarProductId": {
				"type": "string",
				"label": "Polar product ID",
				"description": "A \"pay what you want\" product in your Polar organization, priced in the store currency; each checkout charges the order total against it.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarWebhookSecret": {
				"type": "secret",
				"label": "Polar webhook secret",
				"description": "Secret of the webhook endpoint you create in Polar \u2192 Settings \u2192 Webhooks for the URL below (events: checkout.updated, order.created).",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarWebhookUrl": {
				"type": "info",
				"label": "Polar webhook URL",
				"description": "Add this endpoint in Polar \u2192 Settings \u2192 Webhooks.",
				"value": "{{origin}}/commerce-webhook/polar",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"allowManualPayment": {
				"type": "boolean",
				"label": "Allow pay-later orders",
				"description": "Customers can place an order without paying online (bank transfer, cash on delivery); you confirm payment in Orders."
			},
			"customerAccounts": {
				"type": "boolean",
				"label": "Customer accounts",
				"description": "Shoppers can sign in with an email link to save addresses, reuse saved cards (vaulted by Stripe/Polar \u2014 never stored here) and see their orders."
			},
			"notifyEmail": {
				"type": "string",
				"label": "Notify this email on new orders"
			},
			"storeName": {
				"type": "string",
				"label": "Store name (used in emails)"
			},
			"shippingCountries": {
				"type": "string",
				"label": "Ship to countries",
				"description": "Comma-separated ISO country codes for the shipping address form. Leave empty for a broad default list."
			},
			"allowPromotionCodes": {
				"type": "boolean",
				"label": "Allow promotion codes at checkout"
			},
			"collectPhone": {
				"type": "boolean",
				"label": "Collect phone number at checkout",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"successPath": {
				"type": "string",
				"label": "Success page path",
				"description": "Default /checkout/success (served by the frontend template)."
			},
			"cancelPath": {
				"type": "string",
				"label": "Cancel page path",
				"description": "Default /cart."
			},
			"bookingTimezone": {
				"type": "string",
				"label": "Bookings: time zone",
				"description": "IANA zone the practice works in, e.g. Europe/London. Slots and reminders use it."
			},
			"slotIntervalMin": {
				"type": "number",
				"label": "Bookings: slot interval (minutes)",
				"description": "Start times offered every N minutes (default 15)."
			},
			"leadTimeHours": {
				"type": "number",
				"label": "Bookings: minimum notice (hours)",
				"description": "How far ahead a slot must be to be bookable or cancelled online (default 2)."
			},
			"horizonDays": {
				"type": "number",
				"label": "Bookings: how far ahead (days)",
				"description": "Default 60."
			},
			"holdMinutes": {
				"type": "number",
				"label": "Bookings: hold while paying (minutes)",
				"description": "A chosen slot is reserved this long until payment completes (default 15)."
			},
			"restaurantMode": {
				"type": "boolean",
				"label": "Restaurant mode",
				"description": "Turns the checkout into an order flow with delivery / pickup / dine-in, kitchen tickets, POS and printing.",
				"default": false
			},
			"fulfilmentModes": {
				"type": "string",
				"label": "Order types offered",
				"description": "Comma-separated: delivery, pickup, dine_in",
				"default": "delivery, pickup, dine_in",
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"openingHours": {
				"type": "string",
				"label": "Opening hours",
				"description": "One rule per line or separated by ';'. Example: mon-thu 11:30-22:00; fri-sat 11:30-23:30; sun 12:00-21:00. Times use the booking time zone.",
				"default": "mon-sun 11:30-22:00",
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"prepTimeMin": {
				"type": "number",
				"label": "Kitchen prep time (minutes)",
				"default": 25,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"pickupLeadMin": {
				"type": "number",
				"label": "Pickup lead time (minutes)",
				"default": 20,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"orderSlotIntervalMin": {
				"type": "number",
				"label": "Order time-slot interval (minutes)",
				"default": 15,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"maxOrdersPerSlot": {
				"type": "number",
				"label": "Max orders per slot (0 = unlimited)",
				"default": 0,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"deliveryZones": {
				"type": "string",
				"label": "Delivery zones",
				"description": "One zone per line: Name | postcode prefixes | fee | minimum order | minutes. Example: Central | W1, WC1, WC2 | 2.50 | 15 | 35. Use * for everywhere.",
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"tipPresets": {
				"type": "string",
				"label": "Tip presets (%)",
				"default": "0, 10, 15, 20",
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"serviceChargePct": {
				"type": "number",
				"label": "Service charge for dine-in (%)",
				"default": 0,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"allowPayAtTable": {
				"type": "boolean",
				"label": "Dine-in guests may order now and pay at the table / counter",
				"default": true,
				"showWhen": {
					"field": "restaurantMode",
					"equals": true
				}
			},
			"allowPayOnCollection": {
				"type": "boolean",
				"label": "Allow pay on collection / cash on delivery",
				"default": false,
				"showWhen": {
