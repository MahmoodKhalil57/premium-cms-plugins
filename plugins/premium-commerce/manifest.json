{
	"id": "premium-commerce",
	"version": "1.0.1",
	"capabilities": [
		"content:read",
		"email:send",
		"media:read",
		"media:write",
		"network:request",
		"plugins:call"
	],
	"allowedHosts": [
		"api.polar.sh",
		"api.stripe.com"
	],
	"storage": {
		"orders": {
			"indexes": [
				"status",
				"createdAt",
				"paymentMethod",
				"email",
				"number",
				"expiresAt",
				[
					"status",
					"createdAt"
				],
				"userId"
			],
			"uniqueIndexes": [
				"sessionId"
			]
		},
		"inventory": {
			"indexes": [
				"updatedAt"
			]
		},
		"carts": {
			"indexes": [
				"userId",
				"token",
				"status",
				"updatedAt",
				[
					"status",
					"updatedAt"
				]
			]
		},
		"customers": {
			"indexes": [
				"email",
				"updatedAt"
			]
		},
		"transactions": {
			"indexes": [
				"orderId",
				"provider",
				"kind",
				"createdAt",
				"providerRef"
			]
		},
		"discounts": {
			"indexes": [
				"code",
				"active",
				"updatedAt",
				"endsAt"
			]
		},
		"services": {
			"indexes": [
				"slug",
				"active",
				"sortOrder"
			]
		},
		"staff": {
			"indexes": [
				"active",
				"name"
			]
		},
		"bookings": {
			"indexes": [
				"status",
				"startsAt",
				"serviceId",
				"staffId",
				"orderId",
				[
					"status",
					"startsAt"
				]
			]
		},
		"automations": {
			"indexes": [
				"active",
				"trigger"
			]
		},
		"tables": {
			"indexes": [
				"code",
				"active"
			],
			"uniqueIndexes": [
				"code"
			]
		},
		"tickets": {
			"indexes": [
				"orderId",
				"status",
				"station",
				"createdAt",
				[
					"status",
					"station"
				]
			]
		},
		"printJobs": {
			"indexes": [
				"status",
				"printerId",
				"createdAt",
				[
					"printerId",
					"status"
				]
			]
		},
		"printers": {
			"indexes": [
				"active",
				"target"
			]
		},
		"shifts": {
			"indexes": [
				"staffId",
				"status",
				"openedAt"
			]
		},
		"reservations": {
			"indexes": [
				"status",
				"at",
				"tableId",
				"email"
			]
		}
	},
	"hooks": [
		{
			"name": "plugin:activate"
		},
		{
			"name": "cron"
		}
	],
	"routes": [
		{
			"name": "catalog",
			"public": true,
			"cacheControl": "public, max-age=30"
		},
		{
			"name": "availability",
			"public": true
		},
		{
			"name": "checkout",
			"public": true
		},
		{
			"name": "confirm",
			"public": true
		},
		{
			"name": "webhook",
			"public": true
		},
		{
			"name": "order",
			"public": true
		},
		{
			"name": "upload",
			"public": true
		},
		{
			"name": "admin",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "orders/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "orders/get",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "orders/update",
			"permission": "premium-commerce:orders:manage"
		},
		{
			"name": "orders/refund",
			"permission": "premium-commerce:orders:manage"
		},
		{
			"name": "orders/export",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "inventory/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "inventory/adjust",
			"permission": "premium-commerce:inventory:manage"
		},
		{
			"name": "stats",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "orders/design",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "account/get",
			"session": true
		},
		{
			"name": "account/address-save",
			"session": true
		},
		{
			"name": "account/address-delete",
			"session": true
		},
		{
			"name": "account/payment-method-delete",
			"session": true
		},
		{
			"name": "account/portal",
			"session": true
		},
		{
			"name": "account/orders",
			"session": true
		},
		{
			"name": "cart/get",
			"session": true
		},
		{
			"name": "cart/save",
			"session": true
		},
		{
			"name": "checkout/account",
			"session": true
		},
		{
			"name": "cart/guest",
			"public": true
		},
		{
			"name": "customers/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "carts/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "transactions/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "discounts/preview",
			"public": true
		},
		{
			"name": "discounts/list",
			"permission": "premium-commerce:orders:read"
		},
		{
			"name": "discounts/save",
			"permission": "premium-commerce:orders:manage"
		},
		{
			"name": "discounts/delete",
			"permission": "premium-commerce:orders:manage"
		},
		{
			"name": "orders/collect-balance",
			"permission": "premium-commerce:orders:manage"
		},
		{
			"name": "internal/config",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/catalog",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/order",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/orders",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/create-order",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/settle",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/cancel",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/fulfil",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/extension",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"*"
			]
		},
		{
			"name": "internal/legacy-export",
			"permission": "premium-commerce:orders:manage",
			"callers": [
				"premium-bookings",
				"premium-restaurant"
			]
		}
	],
	"admin": {
		"pages": [
			{
				"path": "/",
				"label": "Orders",
				"icon": "list"
			},
			{
				"path": "/inventory",
				"label": "Inventory",
				"icon": "database"
			},
			{
				"path": "/discounts",
				"label": "Discounts",
				"icon": "tag"
			}
		],
		"widgets": [
			{
				"id": "sales",
				"title": "Sales",
				"size": "half"
			}
		],
		"settingsSchema": {
			"paymentProvider": {
				"type": "select",
				"label": "Payment provider",
				"description": "Who charges your customers at checkout. Pay-later orders work without one.",
				"default": "none",
				"options": [
					{
						"value": "none",
						"label": "None (pay-later orders only)"
					},
					{
						"value": "stripe",
						"label": "Stripe"
					},
					{
						"value": "polar",
						"label": "Polar"
					}
				]
			},
			"currency": {
				"type": "string",
				"label": "Currency",
				"description": "ISO code, e.g. usd, eur, gbp, aed. Prices in the Products collection are in this currency."
			},
			"stripeSecretKey": {
				"type": "secret",
				"label": "Stripe secret key",
				"description": "sk_live_\u2026 or sk_test_\u2026. Checkout, refunds and payment verification use it; it never leaves the server.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"stripeWebhookSecret": {
				"type": "secret",
				"label": "Stripe webhook signing secret",
				"description": "whsec_\u2026 of the webhook endpoint you create at dashboard.stripe.com/webhooks for the URL below (events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired).",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"stripeWebhookUrl": {
				"type": "info",
				"label": "Stripe webhook URL",
				"description": "Add this endpoint in Stripe \u2192 Developers \u2192 Webhooks.",
				"value": "{{origin}}/commerce-webhook/stripe",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"automaticTax": {
				"type": "boolean",
				"label": "Stripe Tax (automatic tax calculation)",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"shippingRates": {
				"type": "string",
				"label": "Stripe shipping rate ids",
				"description": "Comma-separated shr_\u2026 ids offered at checkout for physical products.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"polarAccessToken": {
				"type": "secret",
				"label": "Polar organization access token",
				"description": "polar_oat_\u2026 with checkouts:read, checkouts:write, orders:read and refunds:write scopes.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarProductId": {
				"type": "string",
				"label": "Polar product ID",
				"description": "A \"pay what you want\" product in your Polar organization, priced in the store currency; each checkout charges the order total against it.",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarWebhookSecret": {
				"type": "secret",
				"label": "Polar webhook secret",
				"description": "Secret of the webhook endpoint you create in Polar \u2192 Settings \u2192 Webhooks for the URL below (events: checkout.updated, order.created).",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"polarWebhookUrl": {
				"type": "info",
				"label": "Polar webhook URL",
				"description": "Add this endpoint in Polar \u2192 Settings \u2192 Webhooks.",
				"value": "{{origin}}/commerce-webhook/polar",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "polar"
				}
			},
			"allowManualPayment": {
				"type": "boolean",
				"label": "Allow pay-later orders",
				"description": "Customers can place an order without paying online (bank transfer, cash on delivery); you confirm payment in Orders."
			},
			"customerAccounts": {
				"type": "boolean",
				"label": "Customer accounts",
				"description": "Shoppers can sign in with an email link to save addresses, reuse saved cards (vaulted by Stripe/Polar \u2014 never stored here) and see their orders."
			},
			"notifyEmail": {
				"type": "string",
				"label": "Notify this email on new orders"
			},
			"storeName": {
				"type": "string",
				"label": "Store name (used in emails)"
			},
			"shippingCountries": {
				"type": "string",
				"label": "Ship to countries",
				"description": "Comma-separated ISO country codes for the shipping address form. Leave empty for a broad default list."
			},
			"allowPromotionCodes": {
				"type": "boolean",
				"label": "Allow promotion codes at checkout"
			},
			"collectPhone": {
				"type": "boolean",
				"label": "Collect phone number at checkout",
				"showWhen": {
					"field": "paymentProvider",
					"equals": "stripe"
				}
			},
			"successPath": {
				"type": "string",
				"label": "Success page path",
				"description": "Default /checkout/success (served by the frontend template)."
			},
			"cancelPath": {
				"type": "string",
				"label": "Cancel page path",
				"description": "Default /cart."
			}
		}
	},
	"grants": [
		{
			"key": "orders:read",
			"label": "Read orders",
			"description": "View orders, stats and exports"
		},
		{
			"key": "orders:manage",
			"label": "Manage orders",
			"description": "Fulfil, cancel, refund, mark paid"
		},
		{
			"key": "inventory:manage",
			"label": "Manage inventory",
			"description": "Adjust stock counters"
		}
	]
}
