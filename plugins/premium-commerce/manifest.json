{
	"id": "premium-commerce",
	"version": "0.9.9",
	"capabilities": [
		"content:read",
		"email:send",
		"media:read",
		"media:write",
		"network:request"
	],
	"allowedHosts": [
		"api.polar.sh",
		"api.stripe.com",
		"api.printnode.com"
	],
	"storage": {
		"orders": {
			"indexes": [
				"status",
				"createdAt",
				"paymentMethod",
				"email",
				"number",
				"expiresAt",
				[
					"status",
					"createdAt"
				],
				"userId"
			],
			"uniqueIndexes": [
				"sessionId"
			]
		},
		"inventory": {
			"indexes": [
				"updatedAt"
			]
		},
		"carts": {
			"indexes": [
				"userId",
				"token",
				"status",
				"updatedAt",
				[
					"status",
					"updatedAt"
				]
			]
		},
		"customers": {
			"indexes": [
				"email",
				"updatedAt"
			]
		},
		"transactions": {
			"indexes": [
				"orderId",
				"provider",
				"kind",
				"createdAt",
				"providerRef"
			]
		},
		"discounts": {
			"indexes": [
				"code",
				"active",
				"updatedAt",
				"endsAt"
			]
		},
		"services": {
			"indexes": [
				"slug",
				"active",
				"sortOrder"
			]
		},
		"staff": {
			"indexes": [
				"active",
				"name"
			]
		},
		"bookings": {
			"indexes": [
				"status",
				"startsAt",
				"serviceId",
				"staffId",
				"orderId",
				[
					"status",
					"startsAt"
				]
			]
		},
		"automations": {
			"indexes": [
				"active",
				"trigger"
			]
		},
		"tables": {
			"indexes": [
				"code",
				"active"
			],
			"uniqueIndexes": [
				"code"
			]
		},
		"tickets": {
			"indexes": [
				"orderId",
				"status",
				"station",
				"createdAt",
				[
					"status",
					"station"
				]
			]
		},
		"printJobs": {
			"indexes": [
				"status",
				"printerId",
				"createdAt",
				[
					"printerId",
					"status"
				]
			]
		},
		"printers": {
			"indexes": [
				"active",
				"target"
			]
		},
		"shifts": {
			"indexes": [
				"staffId",
				"status",
				"openedAt"
			]
		},
		"reservations": {
			"indexes": [
				"status",
				"at",
				"tableId",
				"email",
				[
					"status",
					"at"
				]
			]
		}
	},
	"hooks": [
		{
			"name": "plugin:activate"
		},
		{
			"name": "cron"
		}
	],
	"routes": [
