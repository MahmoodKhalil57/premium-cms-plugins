---
/**
 * Add-to-cart control for a product. Works on static pages and inside
 * page-builder sections: any element with data-add-to-cart="<slug>" is
 * wired up by the storefront script at runtime.
 */
import type { Entry } from "../lib/emdash";

interface Props {
	product: Entry;
	label?: string;
}
const { product, label = "Add to cart" } = Astro.props;
const f = product.data.fields;
import { STORE_CURRENCY } from "../plugins/premium-commerce/money";
const sizes = (typeof f.sizes === "string" ? f.sizes.split(/[,\n]+/) : Array.isArray(f.sizes) ? (f.sizes as string[]) : []).map((x) => String(x).trim()).filter(Boolean);
// Option fields: the product's `options` JSON (+ a size select derived from `sizes`, like the server does).
let fields: unknown[] = [];
try {
	const raw = f.options;
	fields = Array.isArray(raw) ? raw : typeof raw === "string" && raw.trim() ? (JSON.parse(raw) as unknown[]) : [];
} catch {
	fields = [];
}
if (sizes.length && !fields.some((x) => (x as { name?: string })?.name === "size")) {
	fields.unshift({ id: "size", type: "select", label: "Size", name: "size", required: true, width: "full", options: sizes.map((v) => ({ value: v, label: v })) });
}
const optionsConfig = fields.length ? { slug: product.id, productId: product.data.id, basePrice: Number(f.price ?? 0), currency: STORE_CURRENCY, fields } : null;
---

{optionsConfig && (
	<div class="ec-product-options-host" data-product-options={product.id}>
		<script type="application/json" set:html={JSON.stringify(optionsConfig).replace(/</g, "\\u003c")} />
	</div>
)}
<div class="ec-add-to-cart-row">
	<label class="ec-qty">
		<span>Qty</span>
		<input type="number" min="1" value="1" data-qty-for={product.id} />
	</label>
	<button type="button" class="ec-add-to-cart" data-add-to-cart={product.id} data-product-id={product.data.id} data-title={product.data.title} data-price={f.price} data-slug={product.id}>
		{label}
	</button>
	<p class="ec-product-card__stock" data-availability={product.data.id} hidden></p>
</div>
