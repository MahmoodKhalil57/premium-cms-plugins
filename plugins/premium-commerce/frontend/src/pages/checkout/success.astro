---
import Base from "../../layouts/Base.astro";
import CmsContent from "../../components/CmsContent.astro";
import { getEmDashCollection } from "../../lib/emdash";

// Designed in the admin as the page with slug `checkout-success` (markers filled by the theme); code is the fallback.
const { entries: pages } = await getEmDashCollection("pages", { limit: 50 });
const page = pages.find((p) => p.id === "checkout-success");
---

<Base title={page?.data.title ?? "Order"}>
	{page ? (
		<CmsContent value={page.data.content} collection="pages" entryId={page.data.id} slug="checkout-success" />
	) : (
		<section class="ec-order">
			<div data-order><p>Checking your order…</p></div>
			<p><a href="/products">← Back to the shop</a></p>
		</section>
	)}
</Base>
